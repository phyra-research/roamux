# ─────────────────────────────────────────────────────────────
# OpenRemote environment configuration (copy to .env)
# ─────────────────────────────────────────────────────────────

# ---- Relay ----
# Port the relay WebSocket server listens on.
RELAY_PORT=8787
# Host the relay binds to. Use 0.0.0.0 to expose on your LAN.
RELAY_HOST=127.0.0.1

# ---- Host daemon ----
# URL of the relay the host connects OUT to.
RELAY_URL=ws://127.0.0.1:8787
# Human-friendly name shown in the UI for this machine.
HOST_NAME=my-macbook
# Agent runtime for the host daemon: "mock" | "opencode"
AGENT_ADAPTER=mock
# Where OpenCode's local server is reachable (only used when AGENT_ADAPTER=opencode).
# Leave OPENCODE_URL empty to have the host spawn `opencode serve` for you.
OPENCODE_URL=
# Default project directory used when creating a new session from the UI.
DEFAULT_PROJECT_PATH=.
# Path to the host's local SQLite state file.
HOST_DB_PATH=.openremote/host.sqlite
# Base web URL used to render the pairing link the host prints.
# For phone access, set this to your laptop's LAN IP, e.g. http://192.168.1.20:3000
WEB_URL=http://localhost:3000

# ---- Web ----
# URL the browser uses to reach the relay's client WebSocket endpoint.
NEXT_PUBLIC_RELAY_URL=ws://127.0.0.1:8787
