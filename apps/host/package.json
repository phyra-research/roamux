{
  "name": "@openremote/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "openremote-host": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
