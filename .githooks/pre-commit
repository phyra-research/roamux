#!/bin/sh
# OpenRemote pre-commit gate. Enable once with:
#   git config core.hooksPath .githooks
# Keeps every contributor (human or agent) to the same Definition of Done.
set -e

if ! command -v bun >/dev/null 2>&1; then
  echo "pre-commit: bun not found on PATH; skipping checks (install bun to enforce)."
  exit 0
fi

echo "pre-commit: running bun run check ..."
bun run check
